{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // Scripts in tools/ run directly in Node (type stripping), which needs the .ts extension.
    "allowImportingTsExtensions": true
  },
  // App build configs run in Node, so they are checked here rather than with the browser code.
  "include": ["*.ts", "tools/**/*.ts", "apps/*/vite.config.ts"]
}
