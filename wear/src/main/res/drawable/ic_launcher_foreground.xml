<?xml version="1.0" encoding="utf-8"?>
<!-- Brand mark: a neon arrow (far pink -> near cyan) inside radar rings. Keep inside the 66dp safe zone (21..87). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <!-- Halo -->
    <path android:pathData="M54,24 a30,30 0 1,1 0,60 a30,30 0 1,1 0,-60 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="54" android:centerY="52" android:gradientRadius="30">
                <item android:offset="0" android:color="#8CFF2E93" />
                <item android:offset="1" android:color="#00FF2E93" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Radar rings -->
    <path android:pathData="M54,23 a31,31 0 1,1 0,62 a31,31 0 1,1 0,-62 Z"
        android:strokeColor="#22E4FF" android:strokeAlpha="0.35" android:strokeWidth="1.6" />
    <path android:pathData="M54,33 a21,21 0 1,1 0,42 a21,21 0 1,1 0,-42 Z"
        android:strokeColor="#22E4FF" android:strokeAlpha="0.55" android:strokeWidth="1.6" />
    <!-- Arrow glow -->
    <path android:pathData="M54,27 L73,77 L54,66 L35,77 Z"
        android:strokeAlpha="0.35" android:strokeWidth="5" android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear" android:startX="54" android:startY="78" android:endX="54" android:endY="28">
                <item android:offset="0" android:color="#FFFF2E93" />
                <item android:offset="0.5" android:color="#FF9D5CFF" />
                <item android:offset="1" android:color="#FF22E4FF" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Arrow -->
    <path android:pathData="M54,27 L73,77 L54,66 L35,77 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="54" android:startY="78" android:endX="54" android:endY="28">
                <item android:offset="0" android:color="#FFFF2E93" />
                <item android:offset="0.5" android:color="#FF9D5CFF" />
                <item android:offset="1" android:color="#FF22E4FF" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Facet highlight -->
    <path android:pathData="M54,27 L54,66 L35,77 Z" android:fillColor="#2EFFFFFF" />
</vector>
