<?xml version="1.0" encoding="utf-8"?>
<!-- Shared formats: times, distances, countdowns. Used everywhere, so translate with care. -->
<resources>
    <string name="time_just_now">just now</string>
    <plurals name="time_min_ago">
        <item quantity="one">%d min ago</item>
        <item quantity="other">%d min ago</item>
    </plurals>
    <plurals name="time_hours_ago">
        <item quantity="one">%d h ago</item>
        <item quantity="other">%d h ago</item>
    </plurals>
    <plurals name="time_days_ago">
        <item quantity="one">%d day ago</item>
        <item quantity="other">%d days ago</item>
    </plurals>
    <string name="time_live">live</string>
    <!-- %1$s = "5 min ago" -->
    <string name="status_battery_died">battery died here · %1$s</string>
    <!-- %1$s = "5 min ago", %2$d = battery percent -->
    <string name="status_time_battery">%1$s · %2$d%%</string>

    <!-- Distances. %1$s is the number, already formatted for the language. -->
    <string name="dist_m">%1$s m</string>
    <string name="dist_km">%1$s km</string>
    <string name="dist_ft">%1$s ft</string>
    <string name="dist_mi">%1$s mi</string>
    <!-- Unit abbreviations on their own (the finder shows the number big and the unit small) -->
    <string name="unit_m">m</string>
    <string name="unit_km">km</string>
    <string name="unit_ft">ft</string>
    <string name="unit_mi">mi</string>
    <!-- %1$s = number, %2$s = unit ("4.5 m"). Reorder if your language puts the unit first. -->
    <string name="dist_number_unit">%1$s %2$s</string>

    <!-- Countdowns to a gig -->
    <string name="countdown_tonight">tonight</string>
    <string name="countdown_tomorrow">tomorrow</string>
    <plurals name="countdown_days">
        <item quantity="one">in %d day</item>
        <item quantity="other">in %d days</item>
    </plurals>
    <plurals name="countdown_weeks">
        <item quantity="one">in %d week</item>
        <item quantity="other">in %d weeks</item>
    </plurals>
    <plurals name="countdown_months">
        <item quantity="one">in %d month</item>
        <item quantity="other">in %d months</item>
    </plurals>
    <!-- Light-me-up colour names ("look for flashing BLUE") -->
    <string name="colour_pink">pink</string>
    <string name="colour_blue">blue</string>
    <string name="colour_green">green</string>
    <string name="colour_orange">orange</string>
    <string name="colour_purple">purple</string>
    <string name="colour_white">white</string>
</resources>
