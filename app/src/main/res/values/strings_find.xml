    <!-- ===== Finder states ===== -->
    <!-- Pill: you're sharing your location / not sharing -->
    <string name="find_pill_live">Live</string>
    <string name="find_pill_hidden">Hidden</string>
    <!-- Screen reader label for the searching radar -->
    <string name="find_searching_cd">Searching</string>
    <!-- %1$s = friend's (or crew's) name -->
    <string name="find_looking_for">Looking for %1$s…</string>
    <string name="find_searching_help">No signal from them and no shared location yet. They need Moshpoint open with Go live on, plus location and mobile data. Then their arrow appears, even if they\'re across town.</string>
    <!-- Bluetooth distance bands: signal strength can only say roughly how close -->
    <string name="find_band_right_here">Right here</string>
    <string name="find_band_close">Close</string>
    <string name="find_band_nearby">Nearby</string>
    <string name="find_band_in_range">In range</string>
    <!-- Small print under each Bluetooth band -->
    <string name="find_band_hint_right_here">within a few metres</string>
    <string name="find_band_hint_close">under 10 m</string>
    <string name="find_band_hint_nearby">about 10–30 m</string>
    <string name="find_band_hint_in_range">30 m or more</string>
    <!-- Warmer/colder chip: getting closer / further / no change -->
    <string name="find_trend_warmer">Warmer</string>
    <string name="find_trend_warmer_hint">Keep going this way</string>
    <string name="find_trend_colder">Colder</string>
    <string name="find_trend_colder_hint">Turn around</string>
    <string name="find_trend_steady">Steady</string>
    <string name="find_trend_steady_hint">Try another direction</string>
