    <string name="find_trend_hint_who">%1$s: %2$s</string>
    <string name="find_warmer_help">Walk a few steps one way, then another. Warmer means you\'re getting closer. The arrow appears once we\'ve worked out which way.</string>
    <!-- Screen reader: %1$d = percent of the full circle the spin scan has covered -->
    <string name="find_scan_covered_cd">%1$d percent of the circle covered</string>
    <!-- Big number in the scan ring: %1$d = percent covered -->
    <string name="find_scan_percent">%1$d%%</string>
    <string name="find_scan_listening">listening…</string>
    <!-- %d = how many times we've picked up their signal during the scan -->
    <plurals name="find_scan_heard">
        <item quantity="one">heard them %d×</item>
        <item quantity="other">heard them %d×</item>
    </plurals>
    <string name="find_spin_slowly">Spin slowly</string>
    <string name="find_spin_help">Hold the phone against your chest, screen facing you, and turn slowly on the spot: about 15 seconds for a full circle. Your body blocks the signal, so we can tell which way they are.</string>
    <!-- Found-them celebration -->
    <string name="find_under_3_metres">UNDER 3 METRES</string>
    <!-- %1$s = friend's name -->
    <string name="find_you_found">You found %1$s</string>
