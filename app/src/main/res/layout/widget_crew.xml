<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget: where the crew is, at a glance, and one tap to find them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_title"
        android:textColor="#FF8E87A6"
        android:textSize="11sp"
        android:letterSpacing="0.15"
        android:textAllCaps="true" />

    <TextView
        android:id="@+id/widget_lines"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:lineSpacingExtra="4dp"
        android:maxLines="4"
        android:text="@string/widget_empty"
        android:textColor="#FFF7F5FF"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/widget_find"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_button"
        android:gravity="center"
        android:text="@string/widget_find"
        android:textColor="#FF07050F"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
