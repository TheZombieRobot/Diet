    <string name="setup_ghost_mode">وضع الشبح</string>
    <string name="setup_ghost_mode_desc">أخفِ مكانك عن الخريطة. يظل بإمكان أصحابك إيجادك عبر Bluetooth عندما يكونون قريبين.</string>
