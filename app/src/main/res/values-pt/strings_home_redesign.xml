<?xml version="1.0" encoding="utf-8"?>
<!-- Brazilian Portuguese: home screen redesign (docs/design/home-redesign, docs/HOME_REDESIGN.md): the Live row, the
     crew header and menu, no crew / first time, and the section titles. Comments for each string are in
     values/strings_home_redesign.xml. Keep labels short: the screen is about 340 dp wide. -->
<resources>
    <!-- Live row -->
    <string name="home_live_switch">Ao vivo</string>
    <string name="home_live_on">Seus amigos te veem</string>
    <string name="home_live_ghost_on">Modo fantasma: fora do mapa, mas te acham de perto</string>
    <string name="home_live_off">Desligado: seus amigos ainda não te veem</string>

    <!-- Crew header and faces -->
    <string name="home_crew_options">Opções da galera</string>
    <plurals name="home_crew_count">
        <item quantity="one">%d na galera</item>
        <item quantity="many">%d na galera</item>
        <item quantity="other">%d na galera</item>
    </plurals>
    <plurals name="home_live_count">
        <item quantity="one">%d ao vivo</item>
        <item quantity="many">%d ao vivo</item>
        <item quantity="other">%d ao vivo</item>
    </plurals>
    <string name="home_face_options">Opções</string>
    <string name="home_friend_options">Opções de %1$s</string>
    <string name="home_face_battery">Bateria: %1$d%%</string>

    <string name="home_share_photos">Postar fotos</string>
    <string name="home_meetup">Encontro: %1$s</string>
    <string name="home_plan_pinned">Fixado no chat da galera</string>
    <string name="home_where_are_they_short">Cadê eles?</string>

    <!-- Crew menu (⋯) -->
    <string name="home_menu_tonight">Hoje à noite</string>
    <string name="home_menu_coming_up">Em breve</string>
    <string name="home_menu_invite">Convidar mais amigos</string>
    <string name="home_menu_invite_sub">Mostre o QR da galera ou envie um link</string>
    <string name="home_menu_family">Compartilhar a noite com a família</string>
    <string name="home_menu_family_sub">Eles acompanham de casa e não podem ser achados</string>
    <string name="home_menu_reset_sub">Um QR e um link novos. Os antigos param de funcionar</string>
    <string name="home_menu_end_sub">Você sai da galera de hoje. Suas fotos ficam em Shows passados</string>
    <string name="home_menu_cancel_sub">Você sai antes do dia do show. Quem já entrou continua na galera</string>
    <string name="home_menu_stop_sub">Você não vai mais ver onde eles estão</string>

    <!-- No crew tonight -->
    <string name="home_no_crew_title">Sem galera hoje</string>
    <string name="home_no_crew_text">Monte uma, mostre o QR pros seus amigos e pronto: vocês já são uma galera.</string>
    <string name="home_start_crew">Montar galera pra hoje</string>
    <string name="home_plan_title">Planejar um show</string>
    <string name="home_plan_sub">Ache agora e convide seus amigos</string>
    <string name="home_join_crew">ENTRAR NUMA GALERA</string>

    <!-- First time -->
    <string name="home_first_title">Ache seus amigos na multidão</string>
    <string name="home_first_text">Monte uma galera e seus amigos escaneiam o QR. Uma seta brilhante aponta pra cada um, mesmo sem sinal.</string>
    <string name="home_plan_another_night">Planejar um show pra outra noite</string>

    <!-- Section titles -->
    <string name="home_section_up_next">Próximos</string>
    <string name="home_section_past_gigs">Shows passados</string>
    <string name="home_section_friends">Amigos</string>
    <string name="home_see_all">Ver todos</string>
    <plurals name="home_mates">
        <item quantity="one">%d amigo</item>
        <item quantity="many">%d amigos</item>
        <item quantity="other">%d amigos</item>
    </plurals>
    <string name="home_upnext_no_mates">Convide seus amigos</string>
</resources>
