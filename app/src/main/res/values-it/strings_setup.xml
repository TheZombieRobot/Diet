    <string name="setup_plan_default_name">Serata concerto</string>

    <string name="setup_qr_title">Scansiona per aggiungermi</string>
    <string name="setup_qr_hint">Poi scansiona il suo, così potete trovarvi.</string>
    <string name="setup_qr_eyebrow">IL TUO CODICE</string>
