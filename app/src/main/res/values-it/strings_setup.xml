    <string name="setup_about">INFO</string>
    <string name="setup_about_text">Moshpoint %1$s. Nessun account, codici a rotazione, posizioni crittografate end-to-end. Puoi essere trovato solo mentre sei live.</string>
    <string name="setup_hide_licences">Nascondi licenze</string>
    <string name="setup_open_source_licences">Licenze open source</string>
    <string name="setup_licences_fonts">Font: Unbounded e Inter, con licenza SIL Open Font License 1.1. Codici QR: ZXing (Apache 2.0).</string>
    <string name="setup_continue_facebook">Continua con Facebook</string>

    <string name="setup_onb_skip">Salta</string>
    <string name="setup_onb_title_find">Trova i tuoi amici\nin mezzo alla folla</string>
    <string name="setup_onb_body_find">Tocca un amico e una freccia punta dritta verso di lui. Si illumina del suo colore quando ti avvicini.</string>
    <string name="setup_onb_title_live">Vai live\nquando entri</string>
    <string name="setup_onb_body_live">I tuoi amici possono trovarti solo mentre sei live, e solo tu lo attivi. Moshpoint ha bisogno di:</string>
    <string name="setup_onb_need_nearby">Dispositivi nelle vicinanze</string>
    <string name="setup_onb_need_nearby_why">per trovare gli amici via Bluetooth, Wi-Fi e UWB</string>
    <string name="setup_onb_need_location">Posizione</string>
    <string name="setup_onb_need_location_why">per la freccia quando siete lontani</string>
    <string name="setup_onb_need_notifications">Notifiche</string>
    <string name="setup_onb_need_notifications_why">così sai sempre quando sei live</string>
    <string name="setup_onb_title_name">Come ti chiamano\ni tuoi amici?</string>
    <string name="setup_onb_or_type_it">oppure scrivilo</string>
    <string name="setup_onb_lets_go">Andiamo!</string>
    <string name="setup_onb_allow">Consenti</string>
    <string name="setup_onb_skip_for_now">Non ora</string>
    <string name="setup_onb_im_name">Sono %1$s</string>
    <string name="setup_onb_arrow_demo_desc">Una freccia che punta verso un amico</string>

    <string name="setup_plan_title">Pianifica un concerto</string>
    <string name="setup_plan_desc">Crea il gruppo ora, ognuno entra quando vuole. Resta in pausa (zero batteria) fino al giorno.</string>
