    <string name="setup_settings_title">Impostazioni</string>
    <string name="setup_your_photo">La tua foto</string>
    <string name="setup_your_photo_desc">Compare nella freccia dei tuoi amici. Solo i tuoi amici possono vederla.</string>
    <string name="setup_take_selfie">Fatti un selfie</string>
