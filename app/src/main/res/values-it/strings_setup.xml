    <string name="setup_qr_reset_invite">Reimposta invito</string>
    <string name="setup_qr_reset_title">Reimpostare l\'invito?</string>
    <string name="setup_qr_reset_text">Se questo QR o uno screenshot è finito in giro, reimpostarlo lo blocca. Chi è già nel gruppo resta dentro; i nuovi avranno bisogno del nuovo QR.</string>
    <string name="setup_qr_reset">Reimposta</string>
    <string name="setup_cancel">Annulla</string>
    <string name="setup_qr_end_night">Chiudi la serata</string>

    <string name="setup_bump_title">Avvicina i telefoni</string>
    <string name="setup_bump_sharing">Tieni il retro del tuo telefono contro quello del tuo amico. Gli verrà chiesto di entrare nel tuo gruppo.</string>
    <string name="setup_bump_joining">Tieni il retro del tuo telefono contro quello di qualcuno in un gruppo (che apre anche lui Avvicina). Ti verrà chiesto di entrare.</string>
    <string name="setup_done">Fatto</string>

    <string name="setup_roll_title">Le tue foto di quella sera</string>
    <string name="setup_roll_looking">Sto guardando le tue foto…</string>
    <string name="setup_roll_nothing">Niente su questo telefono in quelle ore. Le foto fatte con un altro telefono, o già aggiunte, non compaiono qui.</string>
    <string name="setup_roll_tap_to_leave_out">Tocca per escluderne una. Vengono copiate nel concerto, quindi restano anche se le elimini dalla galleria.</string>
