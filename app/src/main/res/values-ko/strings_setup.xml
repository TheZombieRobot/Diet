    <string name="setup_save">저장</string>
    <string name="setup_remove">삭제</string>
    <string name="setup_about">앱 정보</string>
    <string name="setup_about_text">Moshpoint %1$s. 계정 없음, 계속 바뀌는 코드, 종단간 암호화된 위치. 위치 공유 중일 때만 나를 찾을 수 있어요.</string>
    <string name="setup_hide_licences">라이선스 숨기기</string>
    <string name="setup_open_source_licences">오픈소스 라이선스</string>
    <string name="setup_licences_fonts">글꼴: Unbounded, Inter(SIL Open Font License 1.1). QR 코드: ZXing(Apache 2.0).</string>
    <string name="setup_continue_facebook">Facebook으로 계속하기</string>

    <string name="setup_onb_skip">건너뛰기</string>
    <string name="setup_onb_title_find">어떤 인파 속에서도\n친구를 찾아요</string>
    <string name="setup_onb_body_find">친구를 탭하면 화살표가 바로 그 친구를 가리켜요. 가까워질수록 친구의 색으로 빛나요.</string>
    <string name="setup_onb_title_live">입장하면\n위치 공유 켜기</string>
    <string name="setup_onb_body_live">친구들은 내가 위치 공유 중일 때만 나를 찾을 수 있고, 켜는 건 나만 할 수 있어요. Moshpoint에 필요한 것:</string>
    <string name="setup_onb_need_nearby">근처 기기</string>
    <string name="setup_onb_need_nearby_why">Bluetooth, Wi-Fi, UWB로 친구를 찾기 위해</string>
    <string name="setup_onb_need_location">위치</string>
    <string name="setup_onb_need_location_why">멀리 떨어져 있을 때 화살표를 보여 주기 위해</string>
    <string name="setup_onb_need_notifications">알림</string>
    <string name="setup_onb_need_notifications_why">위치 공유 중인지 항상 알 수 있게</string>
    <string name="setup_onb_title_name">친구들이 나를\n뭐라고 부를까요?</string>
    <string name="setup_onb_or_type_it">또는 직접 입력</string>
    <string name="setup_onb_lets_go">시작하기</string>
    <string name="setup_onb_allow">허용</string>
    <string name="setup_onb_skip_for_now">나중에 하기</string>
    <string name="setup_onb_im_name">나는 %1$s!</string>
    <string name="setup_onb_arrow_demo_desc">친구를 가리키는 화살표</string>

    <string name="setup_plan_title">공연 계획하기</string>
    <string name="setup_plan_desc">지금 크루를 만들고, 다들 편할 때 참여하면 돼요. 당일까지는 잠자는 중이에요(배터리 안 써요).</string>
    <string name="setup_plan_search_hint">검색: 밴드, 아티스트, 공연장</string>
    <string name="setup_plan_searching">검색 중…</string>
    <string name="setup_plan_search_failed">지금은 검색할 수 없어요. 아래에 직접 입력하세요.</string>
