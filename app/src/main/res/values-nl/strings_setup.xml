    <string name="setup_about">OVER</string>
    <string name="setup_about_text">Moshpoint %1$s. Geen account, wisselende codes, end-to-end versleutelde locaties. Je bent alleen vindbaar als je live bent.</string>
    <string name="setup_hide_licences">Licenties verbergen</string>
    <string name="setup_open_source_licences">Opensourcelicenties</string>
    <string name="setup_licences_fonts">Lettertypen: Unbounded en Inter, onder de SIL Open Font License 1.1. QR-codes: ZXing (Apache 2.0).</string>
    <string name="setup_continue_facebook">Doorgaan met Facebook</string>

    <string name="setup_onb_skip">Overslaan</string>
    <string name="setup_onb_title_find">Vind je vrienden\nin elke menigte</string>
    <string name="setup_onb_body_find">Tik op een vriend en een pijl wijst recht naar hem of haar. Hij gloeit in hun kleur als je dichterbij komt.</string>
    <string name="setup_onb_title_live">Ga live als\nje naar binnen gaat</string>
    <string name="setup_onb_body_live">Je vrienden kunnen je alleen vinden als je live bent, en alleen jij zet dat aan. Moshpoint heeft nodig:</string>
    <string name="setup_onb_need_nearby">Apparaten in de buurt</string>
    <string name="setup_onb_need_nearby_why">om vrienden te vinden via Bluetooth, Wi-Fi en UWB</string>
    <string name="setup_onb_need_location">Locatie</string>
    <string name="setup_onb_need_location_why">voor de pijl als jullie ver uit elkaar zijn</string>
    <string name="setup_onb_need_notifications">Meldingen</string>
    <string name="setup_onb_need_notifications_why">zodat je altijd weet wanneer je live bent</string>
    <string name="setup_onb_title_name">Hoe moeten je\nvrienden je noemen?</string>
    <string name="setup_onb_or_type_it">of typ hem in</string>
