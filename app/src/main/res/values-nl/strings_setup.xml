    <string name="setup_qr_end_night">Avond afsluiten</string>

    <string name="setup_bump_title">Telefoons botsen</string>
    <string name="setup_bump_sharing">Hou je telefoon rug aan rug tegen die van je vriend. Die krijgt de vraag om bij je crew te komen.</string>
    <string name="setup_bump_joining">Hou je telefoon rug aan rug tegen die van iemand in een crew (die opent ook Botsen). Jij krijgt de vraag om mee te doen.</string>
    <string name="setup_done">Klaar</string>

    <string name="setup_roll_title">Je foto\'s van die avond</string>
    <string name="setup_roll_looking">Je foto\'s doorzoeken…</string>
    <string name="setup_roll_nothing">Niks op deze telefoon uit die uren. Foto\'s van een andere telefoon, of die al zijn toegevoegd, staan hier niet.</string>
    <string name="setup_roll_tap_to_leave_out">Tik om er een weg te laten. Ze worden naar het concert gekopieerd, dus ze blijven ook als je ze uit je galerij verwijdert.</string>
