    <string name="setup_plan_searching">Zoeken…</string>
    <string name="setup_plan_search_failed">Zoeken lukt nu even niet. Typ het hieronder in.</string>
    <string name="setup_plan_no_results">Geen komende concerten gevonden. Typ het hieronder in.</string>
