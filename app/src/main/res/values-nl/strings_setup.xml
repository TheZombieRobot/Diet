    <string name="setup_onb_allow">Toestaan</string>
    <string name="setup_onb_skip_for_now">Nu overslaan</string>
    <string name="setup_onb_im_name">Ik ben %1$s</string>
    <string name="setup_onb_arrow_demo_desc">Een pijl die naar een vriend wijst</string>

    <string name="setup_plan_title">Plan een concert</string>
    <string name="setup_plan_desc">Start de crew nu, iedereen doet mee wanneer het uitkomt. Hij slaapt (geen batterij) tot de dag zelf.</string>
