    <string name="setup_your_name">आपका नाम</string>
    <string name="setup_stay_live">रीस्टार्ट के बाद भी लाइव रहें</string>
    <string name="setup_stay_live_desc">अगर फ़ोन रीस्टार्ट होते समय आप लाइव थे, तो अपने-आप फिर से लाइव हो जाएँ।</string>
    <string name="setup_ghost_mode">घोस्ट मोड</string>
    <string name="setup_ghost_mode_desc">मैप से अपनी जगह छिपाएँ। पास होने पर दोस्त Bluetooth से फिर भी आपको ढूँढ सकते हैं।</string>
    <string name="setup_ghost_one_hour">1 घंटे के लिए घोस्ट</string>
    <string name="setup_data_saver">डेटा सेवर</string>
    <string name="setup_data_saver_desc">हल्की फ़ोटो और क्लिप शेयर करें (कमज़ोर सिग्नल पर तेज़)। बंद: हाई क्वालिटी, ताकि सबकी सेव की गई कॉपी साफ़ रहें। आपकी अपनी ओरिजिनल फ़ाइलें हमेशा फ़ुल क्वालिटी में रहती हैं।</string>
    <string name="setup_emergency_contact">इमरजेंसी कॉन्टैक्ट</string>
    <string name="setup_emergency_contact_desc">\"मदद चाहिए\" उन्हें आपकी लोकेशन नॉर्मल SMS से भेज सकता है (बिना डेटा के भी)। यह इसी फ़ोन पर रहता है।</string>
    <string name="setup_contact_name">नाम</string>
    <string name="setup_contact_mobile">मोबाइल</string>
    <string name="setup_contact_saved">सेव हो गया</string>
    <string name="setup_contact_need_number">मोबाइल नंबर डालें</string>
    <string name="setup_contact_removed">हटा दिया</string>
    <string name="setup_save">सेव करें</string>
    <string name="setup_remove">हटाएँ</string>
    <string name="setup_about">जानकारी</string>
    <string name="setup_about_text">Moshpoint %1$s. कोई अकाउंट नहीं, बदलते कोड, एंड-टू-एंड एन्क्रिप्टेड लोकेशन। आपको सिर्फ़ तभी ढूँढा जा सकता है जब आप लाइव हों।</string>
    <string name="setup_hide_licences">लाइसेंस छिपाएँ</string>
    <string name="setup_open_source_licences">ओपन-सोर्स लाइसेंस</string>
