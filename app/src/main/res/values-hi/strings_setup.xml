    <string name="setup_qr_reset_title">इनवाइट रीसेट करें?</string>
    <string name="setup_qr_reset_text">अगर यह QR या इसका स्क्रीनशॉट बाहर चला गया है, तो रीसेट करने से वह काम करना बंद कर देगा। जो पहले से ग्रुप में हैं वे बने रहेंगे; नए लोगों को नया QR चाहिए होगा।</string>
    <string name="setup_qr_reset">रीसेट</string>
    <string name="setup_cancel">रद्द करें</string>
    <string name="setup_qr_end_night">रात खत्म करें</string>

    <string name="setup_bump_title">फ़ोन बंप करें</string>
    <string name="setup_bump_sharing">अपना फ़ोन दोस्त के फ़ोन से पीठ-से-पीठ सटाकर रखें। उनसे आपके ग्रुप में शामिल होने को कहा जाएगा।</string>
    <string name="setup_bump_joining">अपना फ़ोन किसी ग्रुप वाले के फ़ोन से पीठ-से-पीठ सटाकर रखें (वे भी बंप खोलें)। आपसे शामिल होने को कहा जाएगा।</string>
    <string name="setup_done">हो गया</string>

