    <string name="setup_continue_facebook">Facebook के साथ जारी रखें</string>

    <string name="setup_onb_skip">स्किप</string>
    <string name="setup_onb_title_find">किसी भी भीड़ में\nअपने दोस्त ढूँढें</string>
    <string name="setup_onb_body_find">किसी दोस्त पर टैप करें और तीर सीधे उनकी ओर इशारा करेगा। पास पहुँचते ही यह उनके रंग में चमकने लगता है।</string>
    <string name="setup_onb_title_live">अंदर जाते समय\nलाइव हों</string>
    <string name="setup_onb_body_live">आपके दोस्त आपको सिर्फ़ तभी ढूँढ सकते हैं जब आप लाइव हों, और इसे सिर्फ़ आप ही ऑन करते हैं। Moshpoint को चाहिए:</string>
    <string name="setup_onb_need_nearby">आस-पास के डिवाइस</string>
    <string name="setup_onb_need_nearby_why">Bluetooth, Wi-Fi और UWB से दोस्तों को ढूँढने के लिए</string>
    <string name="setup_onb_need_location">लोकेशन</string>
    <string name="setup_onb_need_location_why">जब आप दूर-दूर हों, तब तीर के लिए</string>
    <string name="setup_onb_need_notifications">नोटिफ़िकेशन</string>
    <string name="setup_onb_need_notifications_why">ताकि आपको हमेशा पता रहे कि आप कब लाइव हैं</string>
